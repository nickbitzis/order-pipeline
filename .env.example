# Copy to .env to override defaults. No secrets are needed.
ORDERPIPELINE_DB_PATH=data/orderpipeline.db
ORDERPIPELINE_SEED=7
ORDERPIPELINE_PROVIDER_FAILURE_RATE=0.1
ORDERPIPELINE_PROVIDER_LATENCY_MS=5
ORDERPIPELINE_MAX_ATTEMPTS=5
ORDERPIPELINE_VISIBILITY_TIMEOUT=5
ORDERPIPELINE_BACKOFF_BASE=0.2
ORDERPIPELINE_BACKOFF_MAX=5
# chaos
ORDERPIPELINE_CRASH_RATE=0
ORDERPIPELINE_DUPLICATE_RATE=0
ORDERPIPELINE_DROP_ACK_RATE=0
ORDERPIPELINE_CRASH_EXITS_PROCESS=false
ORDERPIPELINE_LOG_LEVEL=INFO
